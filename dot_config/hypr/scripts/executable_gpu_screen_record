#!/usr/bin/env bash

set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}"
state_dir="$runtime_dir/hypr-capture"
pid_file="$state_dir/gpu-screen-recorder.pid"
file_file="$state_dir/gpu-screen-recorder.file"
videos_dir="$(xdg-user-dir VIDEOS)/Screen Recordings"

mkdir -p "$state_dir" "$videos_dir"

if [[ -f $pid_file ]] && kill -0 "$(<"$pid_file")" 2>/dev/null; then
	pid="$(<"$pid_file")"
	kill -INT "$pid"
	while kill -0 "$pid" 2>/dev/null; do
		sleep 0.1
	done

	if [[ -f $file_file ]]; then
		notify-send "Screen recording saved" "$(<"$file_file")"
	fi
	rm -f "$pid_file" "$file_file"
	exit 0
fi

rm -f "$pid_file" "$file_file"
region="$(slurp)" || exit 0
filename="$videos_dir/screenrecording-$(date +%Y-%m-%d_%H-%M-%S).mp4"

gpu-screen-recorder -w "$region" -k auto -f 60 -fm cfr -fallback-cpu-encoding yes \
	-o "$filename" -a default_output -ac aac >/dev/null 2>&1 &
pid=$!
echo "$pid" >"$pid_file"
echo "$filename" >"$file_file"

sleep 0.5
if kill -0 "$pid" 2>/dev/null; then
	notify-send "Screen recording started" "Press Alt+Print to stop"
else
	rm -f "$pid_file" "$file_file"
	notify-send -u critical "Screen recording failed" "gpu-screen-recorder exited immediately"
fi
