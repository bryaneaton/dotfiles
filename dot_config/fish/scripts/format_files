#!/usr/bin/env fish


function format_file
    isort $argv[1]
    black $argv[1]
    flake8 $argv[1]
    # pydoclint $argv[1] --style=sphinx
    # git add $argv[1]
end

alias ff="format_file"

function format_files
    # Get the list of staged files
    set changed_files (git diff --name-only --diff-filter=ACMR | grep '\.py$')


	  # Loop through the staged files
	  for file in $changed_files
      echo "Processing $file"
      format_file $file
    end
end
